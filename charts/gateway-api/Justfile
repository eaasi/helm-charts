values_path := "." / "values.yaml"

# Release of the Gateway API
gw_api_version := shell("yq eval '.release.version' " + values_path)
gw_api_channel := shell("yq eval '.release.channel' " + values_path)

# Download URL of the installation bundle
bundle_url := "https://github.com/kubernetes-sigs/gateway-api/releases/download" / gw_api_version / gw_api_channel + "-install.yaml"

# Path of the installation bundle
bundle_path :=  "." / "bundles" / gw_api_channel + ".yaml"

# Download installation bundle
download-bundle:
  mkdir -v -p "{{ parent_directory(bundle_path) }}"
  curl \
    --progress-bar \
    --compressed \
    --location \
    -o "{{ bundle_path }}" \
    "{{ bundle_url }}"

# Patch downloaded installation bundle
patch-bundle:
  #!/bin/sh
  cat << "EOF" | sed -i -e "0r /dev/stdin" "{{ bundle_path }}"
  # Gateway API {{ gw_api_version }} ({{ gw_api_channel }}) installation bundle as downloaded from:
  # {{ bundle_url }}
  #
  # DO NOT EDIT THIS FILE MANUALLY!
  ---
  EOF
  echo "Patched bundle \"{{ bundle_path }}\""

# Update installation bundle
update-bundle: download-bundle patch-bundle
  @echo "Updated bundle to {{ gw_api_version }} ({{ gw_api_channel }})"
